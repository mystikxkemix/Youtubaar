{
  "name": "youtubaar",
  "version": "0.1.0",
  "private": true,
  "description": "Sonarr-style watcher for YouTube channels and playlists: finds new videos, lets you pick or auto-download them through MeTube or yt-dlp.",
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "dev": "tsc -p tsconfig.json && node dist/src/index.js",
    "test": "tsc -p tsconfig.json && node --test \"dist/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
